<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <ExcludeByFile>**/Migrations/*.cs,**/obj/**,**/bin/**,**/tests/**</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <Exclude>[*]*Migrations.*,[Mecanica.Hermes.Cadastros.Api]*Program*,[*Tests]*,[Mecanica.Hermes.Cadastros.TestUtils]*,[*]*Persistence.Entities.*,[*]*Persistence.Configurations.ClienteConfiguration,[*]*Persistence.Configurations.VeiculoConfiguration,[*]*Persistence.Configurations.ProdutoConfiguration,[*]*Persistence.Configurations.ServicoConfiguration,[*]*Persistence.Configurations.WebhookEventConfiguration,[*]*Persistence.AppDbContext,[*]*AppDbContextDesignTimeFactory,[*]*Logging.LogLevelEnricher,[*]*Observability.EnvironmentDetector,[*]*Observability.OtlpEnvironment,[*]*Observability.ActivitySources,[Mecanica.Hermes.Cadastros.Api]Mecanica.Hermes.Cadastros.Api.Endpoints.*Route,[Mecanica.Hermes.Cadastros.Api]Mecanica.Hermes.Cadastros.Api.Endpoints.*Endpoints,[Mecanica.Hermes.Cadastros.Api]Mecanica.Hermes.Cadastros.Api.Endpoints.EndpointConventions,[Mecanica.Hermes.Cadastros.Api]Mecanica.Hermes.Cadastros.Api.Filters.ValidationFilter`1,[Mecanica.Hermes.Cadastros.Api]Mecanica.Hermes.Cadastros.Api.Endpoints.Webhooks.WebhookHtmlResponses,[Mecanica.Hermes.Cadastros.Api]Mecanica.Hermes.Cadastros.Api.Middleware.DevelopmentAuthenticationMiddlewareExtensions,[Mecanica.Hermes.Cadastros.Api]Mecanica.Hermes.Cadastros.Api.Middleware.MiddlewareExtensions,[Mecanica.Hermes.Cadastros.Infrastructure]Mecanica.Hermes.Cadastros.Infrastructure.DependencyInjection.ServiceCollectionExtensions,[Mecanica.Hermes.Cadastros.Infrastructure]Mecanica.Hermes.Cadastros.Infrastructure.DependencyInjection.WebApplicationExtensions,[Mecanica.Hermes.Cadastros.Infrastructure]Mecanica.Hermes.Cadastros.Infrastructure.DependencyInjection.WebApplicationBuilderExtensions,[Mecanica.Hermes.Cadastros.Infrastructure]Mecanica.Hermes.Cadastros.Infrastructure.Emails.DependencyInjection.ServiceCollectionExtensions,[Mecanica.Hermes.Cadastros.Infrastructure]Mecanica.Hermes.Cadastros.Infrastructure.Emails.InternalEmailSenderService,[Mecanica.Hermes.Cadastros.Infrastructure]Mecanica.Hermes.Cadastros.Infrastructure.H