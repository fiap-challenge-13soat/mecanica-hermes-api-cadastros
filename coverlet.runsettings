<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <ExcludeByFile>**/Migrations/*.cs,**/obj/**,**/bin/**,**/tests/**</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <Exclude>[*]*Migrations.*,[Mecanica.Hermes.Cadastros.Api]*Program*,[*Tests]*,[Mecanica.Hermes.Cadastros.TestUtils]*</Exclude>
          <Include>[Mecanica.Hermes.Cadastros.Api]*,[Mecanica.Hermes.Cadastros.Application]*,[Mecanica.Hermes.Cadastros.Domain]*,[Mecanica.Hermes.Cadastros.Infrastructure]*</Include>
          <SkipAutoProps>true</SkipAutoProps>
          <UseSourceLink>false</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
